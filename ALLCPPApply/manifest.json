{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "ALLCPP自动申摊器",
  "version": "1.3.3",
  "description": "自动使用填写好的信息申摊",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.allcpp.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 ALLCPP自动申摊器"
  }
}
